# Fichier : .env.example
# Rôle : liste exhaustive des variables d'environnement requises par Reparo, sans valeurs réelles
# Dépendances : aucune
# Dernière modification : 2026-06-22

# Supabase — récupérer depuis https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=                  # URL du projet Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=             # Clé publique (anon) Supabase, utilisée côté client
SUPABASE_SERVICE_KEY=                      # Clé service_role Supabase (admin, accès complet) — JAMAIS exposée côté client

# Anthropic — récupérer depuis https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=                         # Clé API Claude, utilisée par /api/chat (serveur uniquement)

# Authentification admin back-office Reparo (/admin)
ADMIN_EMAIL=                               # Email de connexion admin
ADMIN_PASSWORD=                            # Mot de passe admin
ADMIN_SECRET=                              # Secret HMAC (min. 32 caractères aléatoires) signant le token de session admin

# Cron Vercel d'agrégation analytics (app/api/cron/analytics-daily)
CRON_SECRET=                               # Secret aléatoire (min. 32 caractères) vérifié sur l'en-tête Authorization du cron

# Tests end-to-end (Playwright) — optionnel, requis uniquement pour `npm run test:e2e`
PLAYWRIGHT_BASE_URL=                       # URL de l'app testée (ex: http://localhost:3000)
CHROMIUM_EXECUTABLE_PATH=                  # Chemin vers un binaire Chromium si celui de Playwright n'est pas utilisable
MOCK_AI=                                   # "1" pour mocker les réponses IA pendant les tests (évite d'appeler l'API Anthropic)
